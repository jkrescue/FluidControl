FROM lpaehler/hydrogym-env@sha256:e0332292172fa3336e169fa1555cce137ddbbb0b38fc5b18da9a7a1e0a68e0d6

COPY --from=ghcr.io/astral-sh/uv:0.12.5@sha256:e85be844203885286c60ffad8a858d48afb6c5a5c237ca0e67f12e74b8f174b1 /uv /uvx /bin/

ARG HYDROGYM_COMMIT

USER firedrake
WORKDIR /home/USER/hydrogym
COPY --chown=firedrake:firedrake . /home/USER/hydrogym

# The base image contains PETSc/Firedrake extensions compiled against NumPy 1.x
# and mpi4py 3.1.5. HydroGym's locked dependencies currently upgrade both ABI
# packages, so preserve the matching mpi4py build and restore a NumPy 1.x wheel.
RUN set -e; \
    site=/home/USER/firedrake/lib/python3.10/site-packages; \
    mkdir -p /tmp/mpi4py-base; \
    cp -a "$site/mpi4py" "$site/mpi4py-3.1.5.dist-info" /tmp/mpi4py-base/; \
    ./scripts/bootstrap_firedrake.sh; \
    rm -rf "$site/mpi4py" "$site"/mpi4py-*.dist-info; \
    cp -a /tmp/mpi4py-base/* "$site"/; \
    uv pip install --python /home/USER/firedrake/bin/python "numpy==1.24.4"; \
    rm -rf /tmp/mpi4py-base

RUN /home/USER/firedrake/bin/python -m pip install \
      --no-cache-dir \
      --index-url https://download.pytorch.org/whl/cpu \
      "torch==2.5.1+cpu" \
 && uv pip install \
      --python /home/USER/firedrake/bin/python \
      "stable-baselines3==2.7.1" \
      "tensorboard==2.20.0"

LABEL org.opencontainers.image.source="https://github.com/dynamicslab/hydrogym" \
      org.opencontainers.image.revision="$HYDROGYM_COMMIT" \
      org.opencontainers.image.numpy-abi="1.24.4" \
      org.opencontainers.image.mpi4py-abi="3.1.5-base-preserved"
